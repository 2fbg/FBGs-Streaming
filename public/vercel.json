{
  "cleanUrls": false,
  "headers": [
    {
      "source": "/(.*)\\.apk",
      "headers": [
        { "key": "Content-Type", "value": "application/vnd.android.package-archive" },
        { "key": "Content-Disposition", "value": "attachment; filename=\"mk21.apk\"" },
        { "key": "Access-Control-Allow-Origin", "value": "*" },
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    },
    {
      "source": "/(.*)\\.ipk",
      "headers": [
        { "key": "Content-Type", "value": "application/octet-stream" },
        { "key": "Content-Disposition", "value": "attachment; filename=\"mk21.ipk\"" },
        { "key": "Access-Control-Allow-Origin", "value": "*" },
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    }
  ],
  "rewrites": [
    { "source": "/api/proxy", "destination": "/api/proxy.js" },
    { "source": "/api/version.json", "destination": "/version.json" },
    { "source": "/web", "destination": "/index.html" },
    { "source": "/web/", "destination": "/index.html" },
    { "source": "/web/index.html", "destination": "/index.html" },
    { "source": "/((?!api/|smart-tv/|css/|js/|.*\\..*).*)", "destination": "/index.html" }
  ]
}
