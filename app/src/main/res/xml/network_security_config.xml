<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Em Release, confia apenas em CAs do sistema (sem certificados instalados pelo usuário).
         Cleartext permanece habilitado no base-config devido a servidores e CDNs IPTV HTTP dinâmicos. -->
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>

    <!-- Endpoints próprios de atualização OTA e backend web exigem HTTPS estrito -->
    <domain-config cleartextTrafficPermitted="false">
        <domain includeSubdomains="true">raw.githubusercontent.com</domain>
        <domain includeSubdomains="true">github.com</domain>
        <domain includeSubdomains="true">objects.githubusercontent.com</domain>
        <domain includeSubdomains="true">release-assets.githubusercontent.com</domain>
        <domain includeSubdomains="true">bgstreaming.vercel.app</domain>
    </domain-config>
</network-security-config>
