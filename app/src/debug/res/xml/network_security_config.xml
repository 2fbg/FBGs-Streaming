<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Apenas builds de debug aceitam certificados de usuário para inspeção local de tráfego -->
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
            <certificates src="user" />
        </trust-anchors>
    </base-config>

    <domain-config cleartextTrafficPermitted="false">
        <domain includeSubdomains="true">raw.githubusercontent.com</domain>
        <domain includeSubdomains="true">github.com</domain>
        <domain includeSubdomains="true">objects.githubusercontent.com</domain>
        <domain includeSubdomains="true">release-assets.githubusercontent.com</domain>
        <domain includeSubdomains="true">bgstreaming.vercel.app</domain>
    </domain-config>
</network-security-config>
