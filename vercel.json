{
  "cleanUrls": false,
  "rewrites": [
    { "source": "/api/proxy", "destination": "/api/proxy.js" },
    { "source": "/api/version.json", "destination": "/version.json" },
    { "source": "/web", "destination": "/index.html" },
    { "source": "/web/", "destination": "/index.html" },
    { "source": "/web/index.html", "destination": "/index.html" },
    { "source": "/((?!api/|smart-tv/|css/|js/|.*\\..*).*)", "destination": "/index.html" }
  ]
}
