<?xml version="1.0" encoding="UTF-8"?>
<widget xmlns="http://www.w3.org/ns/widgets" xmlns:tizen="http://tizen.org/ns/widgets" id="http://yourdomain/MK21Play" version="2.7.1" viewmodes="maximized">
    <tizen:application id="MK21Play.App" exec="index.html" required_version="3.0"/>
    <content src="index.html"/>
    <name>MK21 Play</name>

    <!-- Rede: obrigatório para IPTV/HLS -->
    <tizen:privilege name="http://tizen.org/privilege/internet"/>
    <!-- AVPlay em Tizen 2.4-4.0 (privilégio de parceiro Samsung) -->
    <tizen:privilege name="http://developer.samsung.com/privilege/avplay"/>

    <!--
      O app precisa carregar o webapis antes do bundle do player:
      <script src="$WEBAPIS/webapis/webapis.js"></script>
      Sem isso, window.webapis é undefined e a PlayerFactory degrada para HLS/MSE
      (perde HEVC e DRM).
    -->
</widget>
