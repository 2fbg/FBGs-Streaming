# Variáveis de ambiente para o projeto MK21 MultiServidor (BGs Streaming)

# Keystore e Assinatura de Release
# Defina senhas seguras para compilar e assinar a versão de Release do APK / AAB
STORE_PASSWORD=sua_senha_keystore_aqui
KEY_PASSWORD=sua_senha_chave_aqui
KEYSTORE_PATH=my-upload-key.jks
DEBUG_STORE_PASSWORD=android

# Licenciamento HMAC-SHA256 (legado — mantido para compatibilidade interna)
# Segredo utilizado para gerar e verificar chaves de ativação de dispositivos.
# Obrigatório para build de release (mín. 16 caracteres). Gere com: openssl rand -base64 36
# NUNCA reutilize o valor de exemplo e nunca faça commit do .env real.
LICENSE_SECRET=troque_por_um_segredo_aleatorio_de_32_ou_mais_caracteres

# Aceitar chaves legadas (MD5 + salt fixo)? Deixe false; use true só em migração temporária.
ALLOW_LEGACY_LICENSE=false

# ============================================================================
# Licenciamento ECDSA P-256 (sistema atual — MKL1.<payload>.<assinatura>)
# ============================================================================

# LICENSE_PUBKEY_B64 — Chave pública EC P-256 em DER+Base64 (uma linha).
# Embutida no APK via BuildConfig.LICENSE_PUBKEY_B64 para verificação offline.
# Gere com: openssl ec -in license-private.pem -pubout -outform DER | base64 -w0
# Configure como Secret no GitHub Actions e passe via env no build de release.
LICENSE_PUBKEY_B64=

# LICENSE_SIGNING_KEY — PEM da chave privada EC P-256 com \n escapados.
# Usado pelo servidor Vercel (api/license/) para assinar tokens.
# NUNCA coloque aqui o valor real. Configure apenas na Vercel → Production.
# Gere o par com: scripts/setup-license-keys.sh
LICENSE_SIGNING_KEY=

# DATABASE_URL — String de conexão Neon Postgres (pooled).
# Usado pelas funções serverless em api/license/ e api/sync.js.
# Configure apenas na Vercel → Production (nunca commitar).
# Exemplo: postgresql://user:pass@ep-xxx.neon.tech/neondb?sslmode=require
DATABASE_URL=

# OPENSUBTITLES_API_KEY — Chave da OpenSubtitles REST API v1 (api.opensubtitles.com).
# Usada pelo proxy serverless api/subtitles.js para busca/download de legendas.
# Configure apenas na Vercel → Production (nunca commitar).
OPENSUBTITLES_API_KEY=

# ============================================================================
# Homologação — Envio Automático de Logs da Smart TV para Google Drive
# (Temporário: defina HOMOLOG_LOGS_ENABLED=false ou remova após a homologação)
# ============================================================================
HOMOLOG_LOGS_ENABLED=true
GOOGLE_DRIVE_LOGS_FOLDER_ID=1LqB3dl5ALzgVqUDlYaHzL9XWvv5_ZuGB
# Opção A (Google Drive API v3 — Service Account JSON ou email+chave):
GOOGLE_DRIVE_SERVICE_ACCOUNT_JSON=
GOOGLE_DRIVE_CLIENT_EMAIL=
GOOGLE_DRIVE_PRIVATE_KEY=
# Opção B (alternativa rápida via Google Apps Script Web App https://script.google.com/...):
GOOGLE_DRIVE_WEBHOOK_URL=
# Opcional: token extra de proteção no cabeçalho X-Homolog-Token
HOMOLOG_LOGS_TOKEN=


