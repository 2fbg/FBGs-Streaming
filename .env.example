# Variáveis de ambiente para o projeto MK21 MultiServidor (BGs Streaming)

# Keystore e Assinatura de Release
# Defina senhas seguras para compilar e assinar a versão de Release do APK / AAB
STORE_PASSWORD=sua_senha_keystore_aqui
KEY_PASSWORD=sua_senha_chave_aqui
KEYSTORE_PATH=my-upload-key.jks
DEBUG_STORE_PASSWORD=android

# Licenciamento HMAC-SHA256
# Segredo utilizado para gerar e verificar chaves de ativação de dispositivos
LICENSE_SECRET=MK21_SUPER_SECURE_HMAC_SECRET_2026
