{
  "version": 2,
  "cleanUrls": false,
  "routes": [
    { "src": "/api/proxy", "dest": "/api/proxy.js" },
    { "src": "/api/version.json", "dest": "/version.json" },
    { "src": "/api/(.*)", "dest": "/api/$1" },
    { "src": "/css/(.*)", "dest": "/css/$1" },
    { "src": "/js/(.*)", "dest": "/js/$1" },
    { "src": "/(manifest\\.json|sw\\.js|version\\.json|servers\\.json|mk21.*|icon.*)", "dest": "/$1" },
    { "src": "/(.*)", "dest": "/index.html" }
  ]
}
